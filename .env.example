# REQUIRED on Vercel and in .env.local for local development.
OPENAI_API_KEY=sk-proj-your-key-here

# Recommended cost-sensitive model. Change only if you intentionally want a pricier model.
OPENAI_MODEL=gpt-5.6-luna

# Optional: server-side abuse controls. Defaults are already conservative.
TRACEDESK_RATE_WINDOW_MINUTES=15
TRACEDESK_RATE_MAX_REQUESTS=6
TRACEDESK_DAILY_MAX_REQUESTS=20
TRACEDESK_COOLDOWN_SECONDS=12
